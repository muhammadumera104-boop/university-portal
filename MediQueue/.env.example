# Copy to .env and edit. `npm start` loads it automatically.
PORT=3100
# Staff PIN for the Admin dashboard. The server refuses to start with 1234 when NODE_ENV=production.
ADMIN_PIN=change-me
# 0 = real hospital use (no fake patients). Remove or set to 1 for the demo simulation.
SIMULATE=0
# NODE_ENV=production
# Public address of this server, used in SMS tracking links.
# PUBLIC_URL=https://queue.example-hospital.pk

# SMS (optional) – set ONE provider. Without one, SMS messages are only written to the server log.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx
# Or a local SMS gateway that accepts POST {"to": "+923001234567", "message": "..."}:
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=
