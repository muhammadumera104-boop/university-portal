NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
PASSWORD_RESET_REDIRECT=http://localhost:5173/reset-password
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_URL=postgresql://postgres:your-database-password@db.your-project.supabase.co:5432/postgres
# Largest file upload in MB (1-25). Use 4 on Vercel, which rejects request bodies over about 4.5 MB.
MAX_UPLOAD_MB=25
